{
  "name": "x402-purser",
  "version": "0.1.0",
  "description": "A local daemon that holds the wallet key and decides whether an agent may spend, so the agent cannot decide for itself.",
  "keywords": [
    "x402",
    "agent",
    "payments",
    "policy",
    "eip-3009",
    "mcp"
  ],
  "homepage": "https://github.com/RegardV/x402-purser#readme",
  "bugs": {
    "url": "https://github.com/RegardV/x402-purser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RegardV/x402-purser.git"
  },
  "license": "MIT",
  "author": "RegardV",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "purser": "./dist/cli.js",
    "purser-signer": "./dist/signer/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/smoke.mjs",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@x402/core": "2.19.0",
    "@x402/evm": "2.19.0",
    "viem": "^2.48.11"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^2.1.9",
    "@types/node": "^24.0.0"
  }
}
